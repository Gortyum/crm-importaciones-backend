# Variables de entorno del backend (FastAPI).
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` a GitHub; solo este `.env.example`.

# Base de datos.
# - Dev local: sqlite:///./crm_erp.db  (sin credenciales)
# - Produccion (Railway): referencia automatica al plugin Postgres:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   (Se usa la URL completa y normalizada por el codigo en app/database.py)
DATABASE_URL=sqlite:///./crm_erp.db

# Directorio donde se guardan imagenes subidas (relativo al proyecto).
UPLOAD_DIR=uploads

# Origenes permitidos por CORS, separados por coma.
# - Dev local: http://localhost:5173
# - Produccion (Vercel): https://crm-importaciones-frontend-pi.vercel.app
# - Para permitir ambos: http://localhost:5173,https://crm-importaciones-frontend-pi.vercel.app
# IMPORTANTE: debe listar el/los origin del frontend (donde corre React), no el del backend.
ALLOWED_ORIGINS=http://localhost:5173,https://crm-importaciones-frontend-pi.vercel.app

# ─────────────────────────────────────────────
# Cloudflare R2 (almacenamiento de archivos)
# ─────────────────────────────────────────────
# Si estas variables no estan configuradas, los endpoints /api/archivos/* devuelven
# 503 con un mensaje claro y el flujo local de imagenes (/api/upload/) sigue operando.

# ID de la cuenta de Cloudflare (visible en el panel, esquina inferior izquierda).
R2_ACCOUNT_ID=

# Token de acceso R2 (Access Key ID y Secret). Se crea en:
# Cloudflare -> R2 -> Administrar tokens de API del bucket -> Crear token -> Object Read & Write
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombre exacto del bucket creado en R2.
R2_BUCKET_NAME=

# URL del endpoint S3-compatible. Opcional; por defecto se usa:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# URL base publica del bucket (dominio personalizado o r2.dev). Opcional.
# Solo afecta a archivos y marcados como PUBLICOS (imagenes de productos);
# los documentos se sirven con URLs firmadas por el backend.
R2_PUBLIC_URL=

# Host y puerto del servidor (Railway inyecta PORT automaticamente).
HOST=0.0.0.0
PORT=8000

# Secreto para firmar los tokens JWT del login.
# Genera uno aleatorio en produccion, p. ej. con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=genera-un-secreto-aleatorio-en-produccion

# Cualquier secreto (SECRET_KEY, JWT, API keys) tambien debe ir aqui,
# nunca hardcodeado ni subido a GitHub.
