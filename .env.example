# Variables de entorno del backend (FastAPI).
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` a GitHub; solo este `.env.example`.

# Base de datos.
# - Dev local: sqlite:///./crm_erp.db  (sin credenciales)
# - Produccion (Railway): referencia automatica al plugin Postgres:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   (Se usa la URL completa y normalizada por el codigo en app/database.py)
DATABASE_URL=sqlite:///./crm_erp.db

# Directorio donde se guardan imagenes subidas (relativo al proyecto).
UPLOAD_DIR=uploads

# Origenes permitidos por CORS, separados por coma.
# - Dev local: http://localhost:5173
# - Produccion (Vercel): https://crm-importaciones-frontend-pi.vercel.app
# - Para permitir ambos: http://localhost:5173,https://crm-importaciones-frontend-pi.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Host y puerto del servidor (Railway inyecta PORT automaticamente).
HOST=0.0.0.0
PORT=8000

# Cualquier secreto (SECRET_KEY, JWT, API keys) tambien debe ir aqui,
# nunca hardcodeado ni subido a GitHub.
